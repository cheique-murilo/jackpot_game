# Definir fim de linha como LF para todos os arquivos de texto (padrão web/Render)
* text=auto eol=lf

# Arquivos Python: sempre texto com LF
*.py text eol=lf
*.pyi text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.rst text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
requirements.txt text eol=lf
pyproject.toml text eol=lf
setup.py text eol=lf

# Arquivos de banco/SQLAlchemy: texto
*.sql text eol=lf
*.db diff  # Permite diff simples para bancos SQLite, mas marque como binário se preferir

# Arquivos de frontend: texto com LF (HTML, JS, CSS)
*.html text eol=lf
*.htm text eol=lf
*.js text eol=lf
*.css text eol=lf
*.scss text eol=lf  # Se usar SASS no futuro

# Arquivos de deploy/Render: texto
Procfile text eol=lf
runtime.txt text eol=lf

# Logs e temps: ignore diffs, mas track como texto
*.log text diff  # Permite ver mudanças em logs

# Arquivos binários: não tentar diff/merge (ex: imagens, wheels, envs)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary  # SVG é XML, mas pode ser binário se gerado
*.whl binary
*.egg binary
*.pyc binary
*.pyo binary
__pycache__/ binary
.env binary  # Arquivos de env sensíveis: trate como binário para não diff
*.pkl binary  # Pickles do Python

# Assets do jogo (logos, ícones)
BA.png binary  # Seu logo específico
*.ico binary
